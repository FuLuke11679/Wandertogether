# Supabase (optional — when set + signed in, Home loads trips from cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key-here
# Optional: v2 TikTok video endpoint region (default US). Try JP or EU if transcripts fail for some videos.
SCRAPECREATORS_REGION=US
# Maps Platform: Geocoding + Distance Matrix + Maps Static (required for this repo).
# Places API optional unless you add Places features. Same key; enable products in GCP Library.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
